<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.huoling.wms</groupId>
    <artifactId>wms-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>wms-archtest</artifactId>
  <name>wms-archtest</name>
  <description>构建期架构断言，非可启动单元；十条 ArchUnit 规则的唯一落点</description>

  <dependencies>
    <dependency>
      <groupId>com.huoling.wms</groupId>
      <artifactId>wms-common</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.huoling.wms</groupId>
      <artifactId>wms-kernel</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.huoling.wms</groupId>
      <artifactId>wms-hub</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.huoling.wms</groupId>
      <artifactId>wms-site</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.huoling.wms</groupId>
      <artifactId>wms-open</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.huoling.wms</groupId>
      <artifactId>wms-billing</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit-junit5</artifactId>
      <version>${archunit.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <failIfNoTests>true</failIfNoTests>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
