<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.huoling.wms</groupId>
    <artifactId>wms-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>wms-kernel</artifactId>
  <name>wms-kernel</name>
  <description>十一个业务模块的 domain 包，不依赖 Spring 与 MyBatis</description>

  <dependencies>
    <dependency>
      <groupId>com.huoling.wms</groupId>
      <artifactId>wms-common</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- 单元测试不依赖 Spring 与容器：只引测试框架（JUnit 5 + AssertJ），测试域不在 ArchUnit 分析范围内。 -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
