<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.3.5</version>
    <relativePath/>
  </parent>

  <groupId>com.huoling.wms</groupId>
  <artifactId>wms-parent</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>huoling-wms</name>
  <description>货灵 WMS 后端，模块化单体，四个可启动单元</description>

  <modules>
    <module>wms-common</module>
    <module>wms-kernel</module>
    <module>wms-hub</module>
    <module>wms-site</module>
    <module>wms-open</module>
    <module>wms-billing</module>
    <module>wms-archtest</module>
  </modules>

  <properties>
    <java.version>21</java.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    <archunit.version>1.3.0</archunit.version>
  </properties>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <version>3.5.0</version>
        <executions>
          <execution>
            <id>require-java-21</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <requireJavaVersion>
                  <version>[21,22)</version>
                </requireJavaVersion>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <!--
        集成测试随 verify 执行：surefire 只跑 *Test，failsafe 只跑 *IT，两套各管一段，互不覆盖。
        版本由 spring-boot-starter-parent（3.3.5）管理，不显式写 version；不加 skipITs、不包 profile，
        mvn verify 必须真跑 *IT。
        执行不写 id（默认即 default），与父级 pluginManagement 里的同名执行合并为一次：
        另起 id 会与父级执行各跑一遍，导致 *IT 重复执行。
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <executions>
          <execution>
            <goals>
              <goal>integration-test</goal>
              <goal>verify</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
